# Copy this file to .env.local and fill in your values

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Get MongoDB URI from: https://cloud.mongodb.com (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/shockplan

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get Gemini API key from: https://aistudio.google.com (free, no credit card)
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Auth0 (Authentication) ─────────────────────────────────────────────────
# Create a Regular Web Application at https://manage.auth0.com
# Generate AUTH0_SECRET: openssl rand -hex 32
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=your-random-hex-secret-here

# App base URL (local dev). For preview deploys you can omit and let the SDK infer from the request.
APP_BASE_URL=http://localhost:3000

# Register in Auth0 Application settings:
# - Allowed Callback URLs: http://localhost:3000/auth/callback
# - Allowed Logout URLs: http://localhost:3000
# For production, add https://your-domain.com/auth/callback and https://your-domain.com
